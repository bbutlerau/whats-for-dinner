# Copy to .env and fill in. Never commit .env.

# Where the SQLite database lives. In Docker this points at the mounted volume.
DATABASE_URL=sqlite:///./data/mealplanner.db

# Paprika sync (OPTIONAL, and entirely unofficial).
#
# Paprika publishes no public API. The sync adapter talks to the same private
# endpoint the apps use, which means it can break without warning at any time.
# Leave both of these blank and the app simply hides the sync option — file
# import from a .paprikarecipes export keeps working either way.
PAPRIKA_EMAIL=
PAPRIKA_PASSWORD=

# Set to 1 to enable FastAPI's auto-reload for local development.
DEV_RELOAD=0
